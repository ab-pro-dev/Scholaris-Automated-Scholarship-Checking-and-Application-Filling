# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://scholaris:scholaris@localhost:5432/scholaris?schema=public"

# Redis Configuration (BullMQ Queue)
REDIS_URL="redis://localhost:6379"

# S3 / MinIO Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="scholaris-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# AI Provider API Keys
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Security & Authentication
JWT_SECRET="super-secret-development-jwt-key-replace-in-production-min-32-chars"
JWT_REFRESH_SECRET="super-secret-development-refresh-jwt-key-replace-in-production"
PORT=3001
NODE_ENV="development"
